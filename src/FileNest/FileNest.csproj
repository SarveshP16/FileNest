<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>FileNest</AssemblyName>
    <RootNamespace>FileNest</RootNamespace>
    <Product>FileNest</Product>
    <Version>1.0.1</Version>
    <ApplicationIcon>Assets\FileNest.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>FileNest.Program</StartupObject>
    <Company>FileNest</Company>
    <Description>Keeps your Downloads folder tidy.</Description>
    <Copyright>Copyright (C) 2026 Sarvesh Pandit. Licensed under GPL-3.0.</Copyright>
    <!-- WPF takes per-monitor DPI from app.manifest; the WinForms-only alternative does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only here for the tray icon; keep its types out of the WPF namespaces. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\tabler-icons.ttf" />
    <Resource Include="Assets\FileNest.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileNest.Core\FileNest.Core.csproj" />
  </ItemGroup>

</Project>
