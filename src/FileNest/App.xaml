<Application x:Class="FileNest.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FileNest.Ui"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Ui/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ui:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />
            <ui:EqualsToBoolConverter x:Key="EqualsToBool" />
            <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <ui:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <ui:EmptyToVisibilityConverter x:Key="EmptyToCollapsed" />
            <ui:EmptyToVisibilityConverter x:Key="EmptyToVisible" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
