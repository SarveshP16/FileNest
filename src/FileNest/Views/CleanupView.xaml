<UserControl x:Class="FileNest.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FileNest.Ui">
    <Grid Margin="30,26,18,0" DataContext="{Binding Cleanup}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,12,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Cleanup" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,24,0"
                           Text="Installers for apps that are already on your PC. Moving them to the Recycle Bin frees space, and the apps stay installed." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource SecondaryButton}" Tag="{x:Static ui:Icons.Refresh}" Content="Check again"
                        Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                <Button Style="{StaticResource AccentButton}" Tag="{x:Static ui:Icons.Recycle}" Content="{Binding RecycleText}"
                        Command="{Binding RecycleSelectedCommand}" />
            </StackPanel>
        </Grid>

        <!-- Summary -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,12,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource IconTile}" Background="{DynamicResource AccentBgBrush}">
                    <TextBlock Style="{StaticResource Icon}" FontSize="19" Text="{x:Static ui:Icons.Recycle}" Foreground="{DynamicResource AccentTextBrush}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding Summary}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0" Text="{Binding ScanText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Secondary}" Text="Remind me weekly" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Reminders}" AutomationProperties.Name="Remind me weekly" />
                </StackPanel>
            </Grid>
        </Border>

        <Button Grid.Row="2" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="-4,0,0,6" Content="Select all"
                Command="{Binding SelectAllCommand}" Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibility}}" />

        <ListBox Grid.Row="3" ItemsSource="{Binding Items}" BorderThickness="0" Background="Transparent" Padding="0,0,12,16"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="6,11" Background="Transparent"
                            ToolTip="{Binding FilePath}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource TickBox}" IsChecked="{Binding IsSelected}" Margin="0,0,14,0"
                                      AutomationProperties.Name="{Binding FileName}" />
                            <Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource WarningBgBrush}">
                                <TextBlock Style="{StaticResource Icon}" Text="{x:Static ui:Icons.Package}" Foreground="{DynamicResource WarningTextBrush}" />
                            </Border>
                            <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding FileName}" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Style="{StaticResource Body}" Text="{Binding SizeText}" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Border Grid.Column="4" Style="{StaticResource Pill}" Background="{Binding PillBackground}">
                                <TextBlock Text="{Binding PillText}" FontSize="12" Foreground="{Binding PillForeground}" />
                            </Border>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Content="{x:Static ui:Icons.FolderOpen}" ToolTip="Show in folder"
                                        Command="{Binding DataContext.Cleanup.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="{x:Static ui:Icons.X}" ToolTip="Keep this installer"
                                        Command="{Binding DataContext.Cleanup.KeepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                    Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource Icon}" FontSize="30" Text="{x:Static ui:Icons.CircleCheck}" Foreground="{DynamicResource SuccessTextBrush}" />
            <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" HorizontalAlignment="Center" FontWeight="SemiBold" Text="No leftover installers" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="420"
                       Text="After you download an installer and install the app, FileNest offers to tidy the installer away here." />
        </StackPanel>
    </Grid>
</UserControl>
