<UserControl x:Class="FileNest.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FileNest.Ui">
    <UserControl.Resources>
        <ResourceDictionary Source="ActivityTemplates.xaml" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,28">

            <!-- Header -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Overview" />
                    <TextBlock Style="{StaticResource PathText}" Text="{Binding WatchFolder}" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource SecondaryButton}" Tag="{Binding PauseGlyph}" Content="{Binding PauseText}"
                            Command="{Binding TogglePauseCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource AccentButton}" Tag="{x:Static ui:Icons.Sparkles}" Content="{Binding OrganizeText}"
                            Command="{Binding OrganizeNowCommand}" />
                </StackPanel>
            </Grid>

            <!-- Today -->
            <Border Background="{DynamicResource AccentBgBrush}" CornerRadius="12" Padding="20,15,20,17" Margin="0,0,0,26"
                    TextElement.Foreground="{DynamicResource AccentTextBrush}">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TodayCount}" FontSize="34" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TodayDetail}" FontSize="14" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                        </StackPanel>
                        <TextBlock Text="{Binding AllTimeText}" FontSize="13" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                    <ui:StackedBar Height="8" Margin="0,10,0,11" Segments="{Binding BarSegments}" Track="{DynamicResource AccentTrackBrush}" />
                    <ItemsControl ItemsSource="{Binding Legend}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                    <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Brush}" Margin="0,1,6,0" />
                                    <TextBlock Text="{Binding Text}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontSize="12" Text="Nothing sorted yet today. New downloads will land in their nests on their own."
                               Visibility="{Binding Legend.Count, Converter={StaticResource EmptyToVisible}}" />
                </StackPanel>
            </Border>

            <!-- Leftover installers (only when Cleanup found some) -->
            <Border Style="{StaticResource Card}" Padding="14,11" Margin="0,-10,0,24"
                    Visibility="{Binding Cleanup.HasItems, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource WarningBgBrush}">
                        <TextBlock Style="{StaticResource Icon}" Text="{x:Static ui:Icons.Recycle}" Foreground="{DynamicResource WarningTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Body}" Text="{Binding Cleanup.Summary}" />
                        <TextBlock Style="{StaticResource Muted}" Text="Their apps are already installed, so the installers can go." />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Review" Command="{Binding NavigateCommand}" CommandParameter="Cleanup" />
                </Grid>
            </Border>

            <!-- Nests -->
            <Grid Margin="0,0,0,10">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Your nests" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Tag="{x:Static ui:Icons.Plus}" Content="New nest"
                        Command="{Binding AddNestCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Nests}" Margin="-5,0,-5,22">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource CardButton}" Margin="5" ToolTip="{Binding FolderPath}"
                                Command="{Binding DataContext.OpenNestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel>
                                <Grid>
                                    <Border Style="{StaticResource IconTile}" HorizontalAlignment="Left" Background="{Binding IconBackground}">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="19" Text="{Binding Glyph}" Foreground="{Binding IconForeground}" />
                                    </Border>
                                    <TextBlock Text="{Binding CountText}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Text="· off" Style="{StaticResource Muted}" Margin="6,1,0,0"
                                               Visibility="{Binding Enabled, Converter={StaticResource InverseBoolToVisibility}}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ExtensionSummary}" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Recent activity -->
            <Grid Margin="0,0,0,6">
                <TextBlock Style="{StaticResource SectionTitle}" Text="Recent activity" />
                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Content="View all"
                        Command="{Binding NavigateCommand}" CommandParameter="Activity" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Downloads}" ItemTemplate="{StaticResource DownloadRow}" />
            <ItemsControl ItemsSource="{Binding Recent}" ItemTemplate="{StaticResource RecentRow}" />
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,4"
                    Visibility="{Binding HasRecent, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" FontSize="22" Text="{x:Static ui:Icons.Download}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="Your next download will show up here" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
