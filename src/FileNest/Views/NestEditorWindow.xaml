<Window x:Class="FileNest.Views.NestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <!-- Square option in the icon and colour pickers. -->
        <Style x:Key="PickerOption" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Width="38" Height="38" CornerRadius="9" BorderThickness="1"
                                BorderBrush="{DynamicResource LineBrush}" Background="{DynamicResource Surface2Brush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="BorderThickness" Value="2" />
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBgBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border>
        <StackPanel Margin="24,20,24,20">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border x:Name="PreviewTile" Width="40" Height="40" CornerRadius="10">
                    <TextBlock x:Name="PreviewGlyph" Style="{StaticResource Icon}" FontSize="21" />
                </Border>
                <TextBlock x:Name="HeaderText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Style="{StaticResource Label}" Text="Name" />
            <TextBox x:Name="NameBox" AutomationProperties.Name="Name" TextChanged="Field_Changed" />

            <TextBlock Style="{StaticResource Label}" Text="Folder name" Margin="0,14,0,6" />
            <TextBox x:Name="FolderBox" AutomationProperties.Name="Folder name" TextChanged="Field_Changed" />
            <TextBlock x:Name="FolderHint" Style="{StaticResource Muted}" Margin="0,4,0,0" />

            <TextBlock Style="{StaticResource Label}" Text="File extensions" Margin="0,14,0,6" />
            <TextBox x:Name="ExtensionsBox" AutomationProperties.Name="File extensions" TextChanged="Field_Changed" TextWrapping="Wrap"
                     MinHeight="58" AcceptsReturn="False" VerticalContentAlignment="Top" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Separate with spaces or commas, like  png jpg webp" />

            <TextBlock Style="{StaticResource Label}" Text="Icon" Margin="0,16,0,8" />
            <WrapPanel x:Name="IconPanel" />

            <TextBlock Style="{StaticResource Label}" Text="Color" Margin="0,10,0,8" />
            <WrapPanel x:Name="ColorPanel" />

            <TextBlock x:Name="ErrorText" FontSize="13" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"
                       Margin="0,6,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="88" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" MinWidth="88" Margin="8,0,0,0" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
