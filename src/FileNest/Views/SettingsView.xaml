<UserControl x:Class="FileNest.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FileNest.Ui">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="18,14" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="Settings" Margin="0,0,0,20" />

            <!-- General -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="General" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,24">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource Body}" Text="Start with Windows" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="Open FileNest in the tray when you sign in." />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding StartWithWindows}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource Body}" Text="Show notifications" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="A small pop-up each time a file is sorted, with Undo." />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding ShowNotifications}" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource Body}" Text="Keep running in the tray" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Text="The close button hides the window and FileNest keeps sorting. Quit from the tray icon." />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding CloseToTray}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,24">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Grid>
                            <TextBlock Style="{StaticResource Body}" Text="Theme" VerticalAlignment="Center" />
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="System" Tag="{x:Static ui:Icons.Desktop}"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=System}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Light" Tag="{x:Static ui:Icons.Sun}"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=Light}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Theme" Content="Dark" Tag="{x:Static ui:Icons.Moon}"
                                                 IsChecked="{Binding Theme, Converter={StaticResource EqualsToBool}, ConverterParameter=Dark}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <StackPanel Margin="0,0,300,0">
                                <TextBlock Style="{StaticResource Body}" Text="Window style" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Text="Explorer uses the same Mica material as File Explorer. Glass lets more of your desktop show through." />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0" Foreground="{DynamicResource WarningTextBrush}"
                                           Text="Needs Windows 11 version 22H2 or later."
                                           Visibility="{Binding BackdropSupported, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    IsEnabled="{Binding BackdropSupported}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Content="Explorer"
                                                 IsChecked="{Binding Backdrop, Converter={StaticResource EqualsToBool}, ConverterParameter=Mica}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Content="Glass"
                                                 IsChecked="{Binding Backdrop, Converter={StaticResource EqualsToBool}, ConverterParameter=Acrylic}" />
                                    <RadioButton Style="{StaticResource Segment}" GroupName="Backdrop" Content="Solid"
                                                 IsChecked="{Binding Backdrop, Converter={StaticResource EqualsToBool}, ConverterParameter=Solid}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="Accent color" />
                            <ItemsControl ItemsSource="{Binding Accents}" Margin="0,10,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,8" Cursor="Hand" FocusVisualStyle="{x:Null}" AutomationProperties.Name="{Binding Name}"
                                                Command="{Binding DataContext.SetAccentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Name}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd" CornerRadius="15" Padding="6,5,12,5" BorderThickness="1"
                                                            BorderBrush="{DynamicResource LineStrongBrush}" Background="{DynamicResource Surface2Brush}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="18" Height="18" Fill="{Binding Brush}" />
                                                            <TextBlock x:Name="tx" Text="{Binding Name}" FontSize="13" Margin="7,0,0,0" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter TargetName="bd" Property="BorderThickness" Value="1.5" />
                                                            <Setter TargetName="tx" Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                            <Setter TargetName="tx" Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- About -->
            <!-- Updates -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Updates" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10" Margin="0,0,0,24" DataContext="{Binding Updates}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" Background="{DynamicResource AccentBgBrush}">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="19" Text="{x:Static ui:Icons.CloudDownload}" Foreground="{DynamicResource AccentTextBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold" Text="{Binding StatusText}" />
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0">
                                        <Run Text="{Binding CurrentVersion, Mode=OneWay, StringFormat=You have FileNest {0}}" /><Run Text=". " /><Run Text="{Binding DetailText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}" Tag="{x:Static ui:Icons.Refresh}" Content="Check for updates"
                                            Command="{Binding CheckCommand}" />
                                    <Button Style="{StaticResource AccentButton}" Tag="{x:Static ui:Icons.Download}" Content="Download and install" Margin="8,0,0,0"
                                            Command="{Binding DownloadCommand}"
                                            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Available}" />
                                    <Button Style="{StaticResource AccentButton}" Tag="{x:Static ui:Icons.RotateClockwise}" Content="Restart to update" Margin="8,0,0,0"
                                            Command="{Binding RestartCommand}"
                                            Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Ready}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Style="{StaticResource ThinProgress}" Margin="50,12,0,0" Maximum="100" Value="{Binding Progress}"
                                         Visibility="{Binding State, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Downloading}" />
                            <Border Margin="50,12,0,0" Padding="12,10" CornerRadius="6" Background="{DynamicResource Surface1Brush}"
                                    Visibility="{Binding ReleaseNotes, Converter={StaticResource EmptyToCollapsed}}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Body}" FontWeight="SemiBold"><Run Text="What's new in " /><Run Text="{Binding NewVersion, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,0" Text="{Binding ReleaseNotes}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <Grid>
                            <StackPanel Margin="0,0,60,0">
                                <TextBlock Style="{StaticResource Body}" Text="Update automatically" />
                                <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                                           Text="Download new versions in the background. They install when you restart FileNest." />
                            </StackPanel>
                            <CheckBox Style="{StaticResource ToggleSwitch}" HorizontalAlignment="Right" IsChecked="{Binding AutoUpdate}"
                                      AutomationProperties.Name="Update automatically" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="About" Margin="0,0,0,8" />
            <Border Style="{StaticResource Card}" Padding="18,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" FontSize="23" Foreground="{DynamicResource OnAccentBrush}" Text="{x:Static ui:Icons.Folders}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Version, StringFormat=FileNest {0}}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0" Text="Settings and history are stored in" />
                        <TextBlock Style="{StaticResource PathText}" Margin="0,2,0,0" Text="{Binding DataFolder}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Tag="{x:Static ui:Icons.FolderOpen}" Content="Open"
                            VerticalAlignment="Top" Command="{Binding OpenDataFolderCommand}" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
