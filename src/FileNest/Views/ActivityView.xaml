<UserControl x:Class="FileNest.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FileNest.Ui">
    <Grid Margin="30,26,18,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,12,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitle}" Text="Activity" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,4,24,0" Text="Every file FileNest has moved. Undo puts a file back where it came from." />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Tag="{x:Static ui:Icons.Eraser}" Content="Clear"
                    VerticalAlignment="Top" Command="{Binding ClearHistoryCommand}" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SegmentHost}" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="All"
                             IsChecked="{Binding ActivityFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=All}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="Sorted"
                             IsChecked="{Binding ActivityFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Sorted}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="Renamed"
                             IsChecked="{Binding ActivityFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Renamed}" />
                <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="Undone and failed"
                             IsChecked="{Binding ActivityFilter, Converter={StaticResource EqualsToBool}, ConverterParameter=Failed}" />
            </StackPanel>
        </Border>

        <ListBox Grid.Row="2" ItemsSource="{Binding Activity}" BorderThickness="0" Background="Transparent" Padding="0,0,12,16"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="4,11" Background="Transparent" ToolTip="{Binding ToolTipText}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="8" Background="{Binding IconBackground}">
                                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{Binding IconForeground}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Body}" Text="{Binding FileName}" />
                                <TextBlock Style="{StaticResource Muted}" Text="{Binding Details}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Pill}" Background="{Binding PillBackground}">
                                <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding PillForeground}" />
                            </Border>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Content="{x:Static ui:Icons.FolderOpen}" ToolTip="Show in folder"
                                        Visibility="{Binding CanShow, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.ShowInFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                <Button Style="{StaticResource IconButton}" Content="{x:Static ui:Icons.Undo}" ToolTip="Undo, move it back"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVisibility}}"
                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                            <Setter TargetName="row" Property="Background" Value="{DynamicResource Surface1Brush}" />
                        </Trigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                    Visibility="{Binding HasActivity, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource Icon}" FontSize="26" Text="{x:Static ui:Icons.History}" Foreground="{DynamicResource TextMutedBrush}" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" HorizontalAlignment="Center" Text="Nothing here yet" />
        </StackPanel>
    </Grid>
</UserControl>
