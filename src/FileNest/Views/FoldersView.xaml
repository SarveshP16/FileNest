<UserControl x:Class="FileNest.Views.FoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:FileNest.Ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,26,30,28">
            <TextBlock Style="{StaticResource PageTitle}" Text="Folders" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,4,0,20" Text="Choose the folder FileNest watches and where your nests live." />

            <!-- Watched folder -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Background="{DynamicResource AccentBgBrush}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="19" Text="{x:Static ui:Icons.FolderSearch}" Foreground="{DynamicResource AccentTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Watched folder" />
                        <TextBlock Style="{StaticResource PathText}" Text="{Binding WatchFolder}" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0"
                                   Text="New files that appear here are sorted. Folders, and files inside subfolders, are left alone." />
                        <TextBlock Margin="0,6,0,0" FontSize="12" Foreground="{DynamicResource DangerTextBrush}" Text="This folder doesn't exist. Choose another one."
                                   Visibility="{Binding FolderMissing, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButton}" Tag="{x:Static ui:Icons.FolderOpen}" Content="Open" Command="{Binding OpenWatchFolderCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Change…" Command="{Binding ChangeWatchFolderCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nest location -->
            <Border Style="{StaticResource Card}" Padding="18,16" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" VerticalAlignment="Top" Background="{DynamicResource Surface1Brush}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="19" Text="{x:Static ui:Icons.Folders}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,16,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Nest location" />
                        <TextBlock Style="{StaticResource PathText}" Text="{Binding DestinationRoot}" Margin="0,4,0,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,6,0,0" Text="Nest folders are created inside the watched folder."
                                   Visibility="{Binding UsesCustomDestination, Converter={StaticResource InverseBoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding UsesCustomDestination, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Secondary}" Text="Nest folders are created in this folder." VerticalAlignment="Center" />
                            <Button Style="{StaticResource LinkButton}" Content="Use the watched folder" Margin="6,0,0,0" Command="{Binding ResetDestinationCommand}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource SecondaryButton}" Tag="{x:Static ui:Icons.FolderOpen}" Content="Open" Command="{Binding OpenDestinationCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource SecondaryButton}" Content="Change…" Command="{Binding ChangeDestinationCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Nest folders -->
            <TextBlock Style="{StaticResource SectionTitle}" Text="Nest folders" Margin="0,0,0,8" />
            <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="10">
                <ItemsControl ItemsSource="{Binding Nests}" AlternationCount="1000">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="28" Height="28" CornerRadius="7" Background="{Binding IconBackground}">
                                        <TextBlock Style="{StaticResource Icon}" FontSize="15" Text="{Binding Glyph}" Foreground="{Binding IconForeground}" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Style="{StaticResource Body}" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource PathText}" VerticalAlignment="Center" Text="{Binding FolderPath}" Margin="0,0,12,0" />
                                    <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="{x:Static ui:Icons.FolderOpen}" ToolTip="Open folder"
                                            Command="{Binding DataContext.OpenNestCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Path=(ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}" Value="0">
                                    <Setter TargetName="row" Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
