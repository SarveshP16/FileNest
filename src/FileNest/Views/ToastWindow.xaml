<Window x:Class="FileNest.Views.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FileNest.Ui"
        Title="FileNest notification" Width="372" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <!-- 14px transparent margin leaves room for the shadow. -->
    <Border Margin="14" Background="{DynamicResource SolidCardBrush}" BorderBrush="{DynamicResource LineStrongBrush}"
            BorderThickness="1" CornerRadius="10" Padding="14,12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.18" Direction="270" />
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" FontSize="17" Foreground="{DynamicResource OnAccentBrush}" Text="{x:Static ui:Icons.Folders}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="FileNest" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="ActionButton" Style="{StaticResource LinkButton}" Click="Action_Click" />
                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Content="{x:Static ui:Icons.X}" Margin="4,0,-4,0" Click="Dismiss_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
