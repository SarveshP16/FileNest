<Window x:Class="FileNest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:FileNest.Ui"
        xmlns:views="clr-namespace:FileNest.Views"
        Title="FileNest" Width="1120" Height="790" MinWidth="940" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- Glass frame over the whole window so the Mica/Acrylic backdrop can show through (see WindowsIntegration.ApplyBackdrop). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
            <Border Width="18" Height="18" CornerRadius="5" Background="{DynamicResource AccentBrush}">
                <TextBlock Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource OnAccentBrush}" Text="{x:Static ui:Icons.Folder}" />
            </Border>
            <TextBlock Text="FileNest" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Content="{x:Static ui:Icons.Minus}" ToolTip="Minimize" Click="Minimize_Click" />
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="{x:Static ui:Icons.Square}" ToolTip="Maximize" Click="Maximize_Click" />
            <Button Style="{StaticResource CloseCaptionButton}" Content="{x:Static ui:Icons.X}" ToolTip="Close" Click="Close_Click" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="224" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <DockPanel Margin="12,4,12,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,6,6,22">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}">
                        <TextBlock Style="{StaticResource Icon}" FontSize="23" Foreground="{DynamicResource OnAccentBrush}" Text="{x:Static ui:Icons.Folders}" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FileNest" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Version, StringFormat=v{0}}" />
                    </StackPanel>
                </StackPanel>

                <!-- Status -->
                <Border DockPanel.Dock="Bottom" Margin="0,10,0,0" Padding="13,11" CornerRadius="9" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Warning">
                                    <Setter Property="Background" Value="{DynamicResource WarningBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource WarningTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="Danger">
                                    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource DangerTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,1,8,0"
                                     Fill="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}" />
                            <TextBlock Text="{Binding StatusTitle}" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusSubtitle}" FontSize="12" Margin="16,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Update badge: shows when a new version is available or downloaded. -->
                <Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch"
                        Tag="{x:Static ui:Icons.ArrowUpCircle}" Content="{Binding Updates.BadgeText}" Command="{Binding UpdateBadgeCommand}"
                        Visibility="{Binding Updates.ShowBadge, Converter={StaticResource BoolToVisibility}}" />

                <RadioButton DockPanel.Dock="Bottom" Style="{StaticResource NavItem}" Content="Settings" Tag="{x:Static ui:Icons.Settings}"
                             IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=Settings}" />

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavItem}" Content="Overview" Tag="{x:Static ui:Icons.LayoutDashboard}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=Overview}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Rules" Tag="{x:Static ui:Icons.Adjustments}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=Rules}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Activity" Tag="{x:Static ui:Icons.History}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=Activity}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Folders" Tag="{x:Static ui:Icons.FolderCog}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=Folders}" />
                    <RadioButton Style="{StaticResource NavItem}" Content="Cleanup" Tag="{x:Static ui:Icons.Recycle}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EqualsToBool}, ConverterParameter=Cleanup}" />
                </StackPanel>
                <Border />
            </DockPanel>

            <!-- Content -->
            <Border Grid.Column="1" Background="{DynamicResource LayerBrush}" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" ClipToBounds="True">
                <Grid>
                    <views:OverviewView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Overview}" />
                    <views:RulesView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Rules}" />
                    <views:ActivityView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Activity}" />
                    <views:FoldersView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Folders}" />
                    <views:CleanupView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Cleanup}" />
                    <views:SettingsView Visibility="{Binding CurrentPage, Converter={StaticResource EqualsToVisibility}, ConverterParameter=Settings}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
